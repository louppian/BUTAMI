    "# 셀 2: 이미지 1장 → 안경 분할 → 마스크 적용\n",
    "from pathlib import Path\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "from PIL import Image\n",
    "from glasses_detector import GlassesSegmenter\n",
    "\n",
    "image = Image.open(next(Path(\"/shared/home/mai/JeongGeon/BUTAMI/data/images/regular_glasses\").glob(\"*.jpg\"))).convert(\"RGB\")\n",
    "segmenter = GlassesSegmenter(kind=\"full\", size=\"medium\", device=\"cuda\")\n",
    "mask = np.array(segmenter.predict(image, format=\"mask\")) > 0\n",
    "extracted = np.where(mask[..., None], np.array(image), 255).astype(\"uint8\")\n",
    "\n",
    "fig, axes = plt.subplots(1, 3, figsize=(15, 5))\n",
    "for ax, title, output in zip(axes, [\"Original\", \"Mask\", \"Extracted\"], [image, mask, extracted]):\n",
    "    ax.imshow(output, cmap=\"gray\")\n",
    "    ax.set_title(title)\n",
    "    ax.axis(\"off\")\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
