    "# 셀 1: 데이터와 모델\n",
    "from pathlib import Path\n",
    "import torch\n",
    "from torch import nn\n",
    "from torch.utils.data import Dataset, DataLoader, random_split\n",
    "from PIL import Image\n",
    "from transformers import CLIPModel, CLIPProcessor\n",
    "\n",
    "root = Path(\"/shared/home/mai/JeongGeon/BUTAMI\")\n",
    "device = \"cuda\"\n",
    "torch.manual_seed(42)\n",
    "\n",
    "processor = CLIPProcessor.from_pretrained(\"openai/clip-vit-base-patch32\", cache_dir=str(root / \"ckpt/pretrained/clip\"), local_files_only=True)\n",
    "clip = CLIPModel.from_pretrained(\"openai/clip-vit-base-patch32\", cache_dir=str(root / \"ckpt/pretrained/clip\"), local_files_only=True).to(device).eval()\n",
    "clip.requires_grad_(False)\n",
    "\n",
    "class GlassesDataset(Dataset):\n",
    "    def __init__(self):\n",
    "        self.samples = [(p, label) for label, folder in enumerate([\"regular_glasses\", \"smart_glasses\"]) for p in sorted((root / \"data/images\" / folder).glob(\"*.jpg\"))]\n",
    "\n",
    "    def __len__(self):\n",
    "        return len(self.samples)\n",
    "\n",
    "    def __getitem__(self, index):\n",
    "        path, label = self.samples[index]\n",
    "        with Image.open(path) as image:\n",
    "            pixels = processor(images=image.convert(\"RGB\"), return_tensors=\"pt\")[\"pixel_values\"][0]\n",
    "        return pixels, label\n",
    "\n",
    "dataset = GlassesDataset()\n",
    "assert len(dataset) >= 10, \"학습할 이미지가 부족하다.\"\n",
    "print({folder: sum(label == i for _, label in dataset.samples) for i, folder in enumerate([\"regular_glasses\", \"smart_glasses\"])})\n",
    "\n",
    "\n",
    "# 셀 2: 배치 64로 feature 추출 — 한 번만 수행\n",
    "loader = DataLoader(dataset, batch_size=64, shuffle=False, num_workers=0, pin_memory=True)\n",
    "features, labels = [], []\n",
    "\n",
    "with torch.inference_mode():\n",
    "    for pixels, target in loader:\n",
    "        with torch.autocast(\"cuda\", dtype=torch.float16):\n",
    "            feature = clip.visual_projection(clip.vision_model(pixel_values=pixels.to(device, non_blocking=True)).pooler_output)\n",
    "        feature = nn.functional.normalize(feature.float(), dim=-1)\n",
    "        features.append(feature.cpu())\n",
    "        labels.append(target)\n",
    "\n",
    "features = torch.cat(features)\n",
    "labels = torch.cat(labels)\n",
    "print(\"feature:\", features.shape)\n",
    "\n",
    "# 클래스별 80:20 분리\n",
    "train_ids, val_ids = [], []\n",
    "for label in [0, 1]:\n",
    "    ids = torch.where(labels == label)[0]\n",
    "    assert len(ids) >= 2, f\"클래스 {label} 이미지가 부족하다.\"\n",
    "    ids = ids[torch.randperm(len(ids))]\n",
    "    split = max(1, min(len(ids) - 1, int(len(ids) * 0.8)))\n",
    "    train_ids.append(ids[:split])\n",
    "    val_ids.append(ids[split:])\n",
    "\n",
    "train_ids, val_ids = torch.cat(train_ids), torch.cat(val_ids)\n",
    "train_loader = DataLoader(torch.utils.data.TensorDataset(features[train_ids], labels[train_ids]), batch_size=64, shuffle=True)\n",
    "x_val, y_val = features[val_ids].to(device), labels[val_ids].to(device)\n",
    "\n",
    "# 셀 3: Linear 분류기 학습 + 저장\n",
    "classifier = nn.Linear(features.shape[1], 2).to(device)\n",
    "optimizer = torch.optim.AdamW(classifier.parameters(), lr=1e-3)\n",
    "criterion = nn.CrossEntropyLoss()\n",
    "best_acc = -1\n",
    "save_path = root / \"ckpt/phase3a_train/clip_linear.pt\"\n",
    "save_path.parent.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "for epoch in range(500):\n",
    "    classifier.train()\n",
    "    loss_sum = 0\n",
    "\n",
    "    for x, y in train_loader:\n",
    "        x, y = x.to(device), y.to(device)\n",
    "        optimizer.zero_grad()\n",
    "        loss = criterion(classifier(x), y)\n",
    "        loss.backward()\n",
    "        optimizer.step()\n",
    "        loss_sum += loss.item() * len(y)\n",
    "\n",
    "    classifier.eval()\n",
    "    with torch.no_grad():\n",
    "        prediction = classifier(x_val).argmax(dim=1)\n",
    "        acc = (prediction == y_val).float().mean().item()\n",
    "\n",
    "    if acc > best_acc:\n",
    "        best_acc = acc\n",
    "        torch.save({\"state_dict\": classifier.state_dict(), \"classes\": [\"regular_glasses\", \"smart_glasses\"], \"backbone\": \"openai/clip-vit-base-patch32\", \"feature_dim\": features.shape[1]}, save_path)\n",
    "\n",
    "    print(f\"{epoch + 1:02d}/30 | loss={loss_sum / len(train_ids):.4f} | val_acc={acc:.3f} | best={best_acc:.3f}\")\n",
    "\n",
    "classifier.load_state_dict(torch.load(save_path, map_location=device, weights_only=True)[\"state_dict\"])\n",
    "classifier.eval()\n",
    "print(\"저장:\", save_path)"
   ]
  },
